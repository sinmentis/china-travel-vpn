# Never commit secrets.
# Keys, UUIDs and rendered configs belong in a password manager.

*.key
*.pem
*.crt
*.p12
*.pfx
id_*
!id_*.pub.example

# Rendered configs containing real credentials
config.json
config.yaml
config.yml
*.local.json
*.local.yaml
*.local.txt
*.local.png
secrets*
credentials*
.env
.env.*
.env.vultr
.client-export.*

# Client export formats that embed credentials
*.subscription
*.sub
vless://*
hysteria2://*

# Editor and OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python regression-test artifacts
__pycache__/
*.py[cod]
